generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "linux-musl-arm64-openssl-3.0.x", "debian-openssl-1.1.x", "debian-openssl-3.0.x", "linux-arm64-openssl-1.1.x", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String               @id @default(cuid())
  email               String
  source              String               @default("prynt.ro") // 'shopprint.ro' sau 'prynt.ro'
  name                String?
  phone               String?
  passwordHash        String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  emailVerified       DateTime?
  image               String?
  role                String               @default("user")
  stripeCustomerId    String?              @unique

  @@unique([email, source])
  
  accounts            Account[]
  sessions            Session[]
  orders              Order[]
  addresses           Address[]
  reviews             Review[]
  aiConversations     AiConversation[]
  passwordResetTokens PasswordResetToken[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Address {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  label      String?
  nume       String?
  email      String?
  telefon    String?
  country    String   @default("RO")
  judet      String
  localitate String
  strada_nr  String
  postCode   String?
  bloc       String?
  scara      String?
  etaj       String?
  ap         String?
  interfon   String?
  company    String?
  cui        String?
  regCom     String?
  isDefault  Boolean  @default(false)
  type       String   @default("shipping")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Order {
  id               String      @id @default(cuid())
  orderNo          Int         @unique @default(autoincrement())
  userId           String?
  user             User?       @relation(fields: [userId], references: [id])
  status           String      @default("pending")
  totalAmount      Decimal
  paymentMethod    String
  shippingAddress  Json // Stocăm obiect complet JSON
  billingAddress   Json // Stocăm obiect complet JSON
  invoiceUrl       String?
  awbNumber        String?
  awbCarrier       String?
  shippingFee      Decimal?     @default(0)
  source           String       @default("prynt.ro") // 'shopprint.ro' or 'prynt.ro'
  type             String       @default("order") // "order" | "offer"
  awbLabelBase64   String?
  awbLabelFileName String?
  canceledAt       DateTime?
  items            OrderItem[]
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  
  stripeSessionId  String?     @unique
  marketing        Json?
  termsAcceptedAt  DateTime? // momentul acceptării Termenilor și a Politicii de confidențialitate în checkout
  termsVersion     String?   // versiunea documentelor legale acceptate (lib/company.ts → LEGAL_VERSION)
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  name      String
  quantity  Int
  price     Decimal
  total     Decimal?
  metadata  Json?
  artworkUrl String?
}

model PendingCheckout {
  id           String   @id @default(cuid())
  sessionId    String   @unique
  checkoutData Json
  expiresAt    DateTime
  createdAt    DateTime @default(now())
}

model DiscountCode {
  id             String    @id @default(cuid())
  code           String    @unique
  type           String    
  value          Float     
  minOrderValue  Float?    @default(0)
  maxUses        Int?      
  currentUses    Int       @default(0)
  validFrom      DateTime  @default(now())
  validUntil     DateTime
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Review {
  id          String   @id @default(cuid())
  rating      Int
  title       String?
  content     String
  createdAt   DateTime @default(now())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productSlug String
  
  @@index([productSlug])
}

model Subscriber {
  id        String   @id @default(cuid())
  email     String
  source    String?
  createdAt DateTime @default(now())

  @@unique([email, source])
}

model AiConversation {
  id            String      @id @default(cuid())
  source        String
  identifier    String
  userId        String?
  hasError      Boolean     @default(false)
  isRead        Boolean     @default(false)
  lastMessageAt DateTime    @default(now())
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  aiPaused      Boolean     @default(false)
  customTag     String?
  status        String      @default("active")
  user          User?       @relation(fields: [userId], references: [id])
  messages      AiMessage[]
}

model AiMessage {
  id             String         @id @default(cuid())
  conversationId String
  role           String
  content        String
  createdAt      DateTime       @default(now())
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

model AbandonedCart {
  id              String   @id @default(cuid())
  email           String
  configuratorId  String
  cartData        Json
  emailSentCount  Int      @default(0)
  lastEmailSent   DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  source          String   @default("prynt.ro")

  @@unique([email, configuratorId])
}

/// Cerere de retragere dintr-un contract la distanță (OUG 18/2026 - dreptul de retur).
model WithdrawalRequest {
  id          String   @id @default(cuid())
  name        String
  email       String
  phone       String?
  orderRef    String
  products    String   @db.Text
  message     String?  @db.Text
  status      String   @default("pending")
  source      String   @default("tablou.net")
  createdAt   DateTime @default(now())
}

// Shared print database: every site's schema must list every table, otherwise
// `prisma db push` on deploy would treat it as unknown (it belongs to shopprint's AI graphics).
model AiGraphicGeneration {
  id                String   @id @default(cuid())
  ipHash            String
  previewUrl        String   @unique
  cleanPublicId     String?
  printWidthCm      Int      @default(100)
  printHeightCm     Int      @default(100)
  userPrompt        String   @default("") @db.Text
  imagePrompt       String?  @db.Text
  product           String?
  productKind       String?
  material          String?
  referenceImageUrl String?
  mode              String   @default("create")
  productionStatus  String   @default("preview")
  orderId           String?
  createdAt         DateTime @default(now())

  @@index([ipHash, createdAt])
  @@index([orderId])
  @@index([productionStatus])
}

// Cheltuiala pe reclame (Google Ads, trimisa de scriptul din cont), un rand pe campanie pe zi.
// Baza e comuna tuturor site-urilor de print: modelul e in schema fiecaruia, ca db push sa nu-l stearga.
model AdSpendDaily {
  id              String   @id @default(cuid())
  provider        String
  date            DateTime @db.Date
  campaignId      String
  campaignName    String
  currency        String
  spend           Decimal  @db.Decimal(14, 2)
  impressions     Int      @default(0)
  clicks          Int      @default(0)
  conversions     Decimal  @default(0) @db.Decimal(14, 2)
  conversionValue Decimal  @default(0) @db.Decimal(14, 2)
  updatedAt       DateTime @updatedAt

  @@unique([provider, date, campaignId])
  @@index([date])
}

// Tracking propriu al site-urilor de print (www.shopprint.ro/t.js): o vizita = un rand.
// Sursa (Google, Facebook, reclame, direct...) se stabileste la prima pagina.
model TrackVisit {
  id           String   @id
  visitorId    String
  host         String
  date         DateTime @db.Date
  startedAt    DateTime @default(now())
  lastSeenAt   DateTime @default(now())
  landingPath  String
  referrerHost String?
  source       String
  medium       String
  campaign     String?
  clickType    String?
  device       String
  pageviews    Int      @default(1)

  @@index([date])
  @@index([host, date])
}

// Datele pentru „Date și rapoarte” din admin-ul shopprint (Search Console, GA4, Bing, Merchant, alerte, reclame).
// Baza e comuna site-urilor de print: modelele stau si aici, ca `prisma db push` sa nu le stearga.

// Google Search Console, pe site pe zi
model PrintGscDaily {
  site        String
  date        DateTime @db.Date
  clicks      Int
  impressions Int
  position    Float

  @@id([site, date])
  @@index([date])
}

// Topul cautarilor si al paginilor: ultimele 28 de zile cu date ("cur") si cele 28 dinainte ("prev")
model PrintGscTop {
  id          String @id @default(cuid())
  site        String
  kind        String // query | page
  period      String // cur | prev
  key         String
  clicks      Int
  impressions Int
  position    Float

  @@index([site, kind, period])
}

// Google Analytics 4 pe site, zi si canal; channel "(total)" = vizitatorii unici ai zilei
model PrintGa4Daily {
  site      String
  date      DateTime @db.Date
  channel   String
  users     Int
  sessions  Int
  purchases Int
  revenue   Decimal  @db.Decimal(14, 2)

  @@id([site, date, channel])
  @@index([date])
}

// Paginile de intrare din GA4 (ultimele 30 de zile), cu vanzarile lor
model PrintGa4Landing {
  id          String   @id @default(cuid())
  site        String
  path        String
  sessions    Int
  purchases   Int
  revenue     Decimal  @db.Decimal(14, 2)
  periodStart DateTime @db.Date
  periodEnd   DateTime @db.Date

  @@index([site])
}

// Bing Webmaster, pe site pe zi
model PrintBingDaily {
  site        String
  date        DateTime @db.Date
  clicks      Int
  impressions Int

  @@id([site, date])
}

// Google Merchant Center: o poza pe zi a starii produselor
model PrintMerchantSnapshot {
  date          DateTime @id @db.Date
  total         Int
  approved      Int
  pending       Int
  disapproved   Int
  issues        Json
  accountIssues Json
  updatedAt     DateTime @updatedAt
}

// Ultima citire din fiecare sursa (gsc, ga4, bing, merchant, google-ads, meta-ads)
model PrintSyncState {
  source    String    @id
  lastRunAt DateTime?
  lastOkAt  DateTime?
  lastError String?
  info      Json?
}

// Alertele adminului de print (scadere clicuri/comenzi, citiri esuate, produse respinse)
model PrintAlert {
  key        String    @id
  kind       String
  site       String?
  message    String
  active     Boolean   @default(true)
  firstAt    DateTime  @default(now())
  lastAt     DateTime  @default(now())
  resolvedAt DateTime?

  @@index([active])
}

// Campaniile de reclame si site-ul caruia ii apartin (dupa nume sau dupa adresa din reclame)
model PrintAdCampaign {
  provider   String
  campaignId String
  name       String
  site       String?
  updatedAt  DateTime @updatedAt

  @@id([provider, campaignId])
}

// Microsoft Clarity pe site pe zi: cum se poarta vizitatorii (o citire pe zi, API-ul da doar ultimele 24 de ore).
// date = ziua citirii minus una (citirea de dimineata acopera in mare ziua de ieri). Timpii in secunde / sesiune.
model PrintClarityDaily {
  site            String
  date            DateTime @db.Date
  sessions        Int
  botSessions     Int
  users           Int
  pagesPerSession Float?
  scrollDepth     Float?
  totalTime       Float?
  activeTime      Float?
  rageClicks      Int
  rageSessions    Int
  deadClicks      Int
  deadSessions    Int
  quickbacks      Int
  excessiveScroll Int
  scriptErrors    Int
  errorSessions   Int
  errorClicks     Int
  pages           Json?
  fetchedAt       DateTime @default(now())

  @@id([site, date])
  @@index([date])
}

// Consumul AI al site-urilor de print (lib/aiUsage.ts, identic in cele 6 site-uri). Tabele create cu prisma/sql/20260929_print_insights.sql.
// Pe zi (ora Romaniei), site, furnizor, model si functie; calls = apeluri reusite, errors = esuate, unpriced = apeluri fara pret cunoscut (ex. imagini).
model PrintAiUsageDaily {
  site         String
  date         DateTime @db.Date
  provider     String
  model        String
  feature      String
  calls        Int      @default(0)
  errors       Int      @default(0)
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  cachedTokens Int      @default(0)
  costUsd      Float    @default(0)
  unpriced     Int      @default(0)
  updatedAt    DateTime @default(now()) @updatedAt

  @@id([site, date, provider, model, feature])
  @@index([date])
}

// Erorile recente ale apelurilor AI (kind: credit | auth | rate | other)
model PrintAiError {
  id       String   @id @default(cuid())
  site     String
  provider String
  model    String
  feature  String
  kind     String
  message  String
  at       DateTime @default(now())

  @@index([at])
  @@index([site, at])
}

// Bugetul AI pe site (USD); fara rand: 2 $/zi, 20 $/luna
model PrintAiBudget {
  site       String   @id
  dailyUsd   Float    @default(2)
  monthlyUsd Float    @default(20)
  updatedAt  DateTime @default(now()) @updatedAt
}

// Alertele AI trimise pe e-mail (deduplicare: credit/cheie max 1 pe 24 h, bugetul o data pe zi / luna)
model PrintAiAlert {
  key     String   @id
  kind    String
  site    String?
  message String
  sentAt  DateTime @default(now())

  @@index([sentAt])
}
